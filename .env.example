# Copy to .env and edit before running `docker compose up -d`.

# REQUIRED. Long random string used to sign JWT tokens.
# Generate one with:  openssl rand -base64 48
SCREENER_JWT_SECRET=change-me-to-a-long-random-secret

# First super-user (seeded only on a fresh database).
SCREENER_ADMIN_EMAIL=admin@screener.io
# Leave empty to have a strong password generated and printed once in the
# backend logs (docker compose logs backend), then change it from the UI.
SCREENER_ADMIN_PASSWORD=

# Host port the web UI is published on (http://SERVER_IP:8080 by default).
SCREENER_HTTP_PORT=8080

# Database. SQLite (default) needs no extra service. For Postgres add a `db`
# service and set, e.g.:
# SCREENER_DATABASE_URL=postgresql+psycopg://screener:secret@db:5432/screener
SCREENER_DATABASE_URL=sqlite:////data/screener.db
